{
  "manifest_version": 3,
  "name": "Magpie Browser",
  "version": "0.1.7",
  "description": "Lets the agents you run through Magpie use this browser: your tabs, signed in to the sites you use.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Magpie Browser", "default_popup": "popup.html" },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" }
}
