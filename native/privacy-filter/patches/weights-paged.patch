+bool model_file::map(const std::string & path) {
+    if (!guf || !ctx) {
+        error = "map before open";
+        return false;
+    }
+#ifdef _WIN32
+    HANDLE f = CreateFileA(path.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING,
+                           FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (f == INVALID_HANDLE_VALUE) {
+        error = "failed to open GGUF for mapping: " + path;
+        return false;
+    }
+    LARGE_INTEGER sz;
+    if (!GetFileSizeEx(f, &sz)) {
+        CloseHandle(f);
+        error = "failed to size GGUF: " + path;
+        return false;
+    }
+    map_size   = (size_t) sz.QuadPart;
+    map_handle = CreateFileMappingA(f, nullptr, PAGE_READONLY, 0, 0, nullptr);
+    CloseHandle(f);
+    if (map_handle) {
+        map_addr = MapViewOfFile(map_handle, FILE_MAP_READ, 0, 0, 0);
+    }
+    if (!map_addr) {
+        error = "failed to map GGUF: " + path;
+        if (map_handle) { CloseHandle(map_handle); map_handle = nullptr; }
+        map_size = 0;
+        return false;
+    }
+#else
+    const int fd = ::open(path.c_str(), O_RDONLY);
+    if (fd < 0) {
+        error = "failed to open GGUF for mapping: " + path;
+        return false;
+    }
+    struct stat st;
+    if (fstat(fd, &st) != 0) {
+        ::close(fd);
+        error = "failed to size GGUF: " + path;
+        return false;
+    }
+    map_size = (size_t) st.st_size;
+    void * a = mmap(nullptr, map_size, PROT_READ, MAP_SHARED, fd, 0);
+    ::close(fd);
+    if (a == MAP_FAILED) {
+        map_size = 0;
+        error = "failed to map GGUF: " + path;
+        return false;
+    }
+    map_addr = a;
+#endif
+    const size_t off = gguf_get_data_offset(guf);
+    if (off > map_size) {
+        error = "GGUF shorter than its header: " + path;
+        return false;
+    }
+    data      = (char *) map_addr + off;
+    data_size = map_size - off;
+    for (ggml_tensor * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+        const int64_t id = gguf_find_tensor(guf, ggml_get_name(t));
+        if (id < 0) {
+            error = std::string("tensor not in GGUF: ") + ggml_get_name(t);
+            return false;
+        }
+        const size_t o = gguf_get_tensor_offset(guf, id);
+        if (o > data_size || ggml_nbytes(t) > data_size - o) {
+            error = std::string("GGUF cut short in tensor ") + ggml_get_name(t);
+            return false;
+        }
+        t->data = (char *) data + o;
+    }
+    return true;
+}
+
 void model_file::close() {
+    if (map_addr) {
+#ifdef _WIN32
+        UnmapViewOfFile(map_addr);
+#else
+        munmap(map_addr, map_size);
+#endif
+        map_addr = nullptr;
+    }
+#ifdef _WIN32
+    if (map_handle) { CloseHandle((HANDLE) map_handle); map_handle = nullptr; }
+#endif
+    map_size  = 0;
+    data      = nullptr;
+    data_size = 0;
     if (ctx) { ggml_free(ctx);  ctx = nullptr; }
     if (guf) { gguf_free(guf);  guf = nullptr; }
     hp = hparams{};
