@@ -50,8 +50,24 @@ struct model_file {
     bool open(const std::string & path, bool with_data);
     void close();
 
+    // map maps the file read-only and points each tensor of a file opened
+    // without data at its bytes in the mapping, in place of a copy: the
+    // weights are then pages of the file, which the system reads in as
+    // they are used and can let go under memory pressure, not 1.6 GB of
+    // the process's own memory. data and data_size are the tensors' region.
+    bool   map(const std::string & path);
+    void * data      = nullptr;
+    size_t data_size = 0;
+
     ggml_tensor * tensor(const char * name) const;   // nullptr if absent
     ggml_tensor * require(const char * name);        // sets error if absent
+
+  private:
+    void * map_addr = nullptr;
+    size_t map_size = 0;
+#ifdef _WIN32
+    void * map_handle = nullptr;
+#endif
 };
 
 } // namespace pf
