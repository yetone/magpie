// usemagpie.ai: the static site in public/, plus worker.js for the update
// feed and the download links. Deploy with `npx wrangler deploy` from here.
{
  "name": "usemagpie",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // the contributors page's list, from git history (credits-cli.mjs); a
  // build that can't read git or GitHub keeps the last list, or none
  "build": { "command": "node credits-cli.mjs wall" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // every request, so worker.js can send www.usemagpie.ai to usemagpie.ai
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "usemagpie.ai", "custom_domain": true },
    { "pattern": "www.usemagpie.ai", "custom_domain": true },
    // shared artifacts' files (shares.js), a host of their own
    { "pattern": "a.usemagpie.ai", "custom_domain": true }
  ],
  // the ledger of releases the Stable channel is chosen from (worker.js,
  // "The Stable channel"), kept by the cron every quarter hour
  "kv_namespaces": [{ "binding": "LEDGER", "id": "716b22ec7d4c496abb7b3dc085258fde" }],
  // RELEASES: each release's files, copied from GitHub by the five-minute
  // cron and served at /files (files.js)
  "r2_buckets": [
    { "binding": "RELEASES", "bucket_name": "magpie-releases" },
    // SHARES: shared artifacts' files, SHARES_DB the shares (shares.js)
    { "binding": "SHARES", "bucket_name": "magpie-shares" }
  ],
  // PLUGINS: Discover's counts, each plugin's users and likes
  // (pluginstats.js)
  "d1_databases": [
    { "binding": "PLUGINS", "database_name": "magpie-plugins", "database_id": "ec0a0670-9de4-4906-8534-ac83c8ba3cd6" },
    { "binding": "SHARES_DB", "database_name": "magpie-shares", "database_id": "e95cac10-9301-4f26-bb09-6d0e115f2762" }
  ],
  // LIVE: each shared page's data and room, by the share's id (live.js);
  // LIVE_KEY, a secret, signs its viewers' tokens
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "ShareLive" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShareLive"] }],
  "triggers": { "crons": ["*/15 * * * *", "*/5 * * * *"] },
  "observability": { "enabled": true }
}
